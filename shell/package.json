{
  "name": "kage-shell",
  "version": "3.2.0",
  "private": true,
  "description": "Kage desktop shell — a thin Electron frame over the daemon's renderer. Contains zero HTML.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir --config electron-builder.config.js",
    "dmg": "electron-builder --mac dmg zip --config electron-builder.config.js",
    "release": "electron-builder --mac dmg zip --publish always --config electron-builder.config.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
