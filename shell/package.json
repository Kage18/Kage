{
  "name": "kage-shell",
  "version": "3.1.0",
  "private": true,
  "description": "Kage desktop shell \u2014 a thin Electron frame over the daemon's renderer. Contains zero HTML.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --dir --config electron-builder.config.js",
    "dmg": "electron-builder --mac dmg --config electron-builder.config.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
